# --- Database: set EITHER DATABASE_URL OR the discrete PG* vars, not both ---
# Use your Supabase connection string here for PostgreSQL
DATABASE_URL=postgresql://user:password@host:port/dbname
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

OPENAI_API_KEY=
# Optional -- chat fallback if OpenAI fails or a client's per-minute cap is hit
NARAROUTER_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_PROJECT=regulense
LANGSMITH_API_KEY=

# Optional — CORS origins for local dev
ALLOWED_ORIGINS=http://localhost:5173

# Optional — worst-case ceiling on API calls/day, default 300
DAILY_OPENAI_CALL_CAP=300

# Optional — test DB override; falls back to PG* vars with dbname=test_regulense
TEST_DATABASE_URL=
