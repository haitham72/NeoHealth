# Leave blank for Vite's local development proxy. Set this to the deployed
# backend origin only when the frontend is hosted separately from the API.
VITE_API_URL=

# Supabase client config (public identifiers, not secrets) -- from the Supabase
# dashboard's Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
